# MongoDB connection string. Local Docker default shown for development.
MONGODB_URI=mongodb://mongodb:27017/omnirag?replicaSet=rs0&directConnection=true

# Neo4j connection details. Local Docker default shown for development.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=omnirag_password

# Redis connection string. Local Docker default shown for development.
REDIS_URL=redis://redis:6379/0

# Groq configuration.
GROQ_API_KEY=gsk_replace_me
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_SMART=llama-3.1-70b-versatile

# Ollama local server. Used for privacy classification in local development.
OLLAMA_BASE_URL=http://ollama:11434

# Google OAuth 2.0 credentials.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# JWT signing keys. Paste PEM values or load them through deployment secrets.
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nreplace-me\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace-me\n-----END PUBLIC KEY-----"

# Webhook validation secrets.
GITHUB_WEBHOOK_SECRET=replace-with-random-32-char-string
SLACK_SIGNING_SECRET=replace-me

# Graph and intelligence configuration.
ENTITY_MERGE_THRESHOLD=0.85
GRAPH_EXPANSION_HOPS=2
KTD_INACTIVITY_DAYS=14

# Runtime configuration.
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
PORT=3001
NODE_ENV=development
